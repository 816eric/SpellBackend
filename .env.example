# Backend Environment Configuration
# Copy to .env and configure for your deployment environment

# Database Configuration
DATABASE_PATH=/database/db.sqlite3

# Templates
TEMPLATES_PATH=./templates

# API Configuration
API_BASE_URL=http://localhost:8000

# Admin panel (/admin) Basic Auth credentials.
# Required — with these unset, /admin is inaccessible (fails closed).
# In production these are set as Fly secrets, not in this file:
#   flyctl secrets set ADMIN_USERNAME=... ADMIN_PASSWORD=... -a spellbackend
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign login tokens (openssl rand -hex 32). If unset, a random
# one is generated and stored beside the database.
AUTH_SECRET=
# Gemini API key for the AI features (never commit a real key)
Gemini_key=
# Extra browser origins allowed by CORS (comma separated). The *.pages.dev
# frontends and localhost are always allowed.
CORS_ORIGINS=
# Set true to expose /docs, /redoc and /openapi.json (off by default)
ENABLE_DOCS=false

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true

# Production Notes:
# - Set SERVER_RELOAD=false in production
# - Use a reverse proxy (nginx, Traefik) in front of the API
# - Enable HTTPS with proper SSL certificates
# - Set DATABASE_PATH to a persistent volume in containerized environments
